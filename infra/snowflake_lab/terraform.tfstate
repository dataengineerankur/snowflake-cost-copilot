        {
          "schema_version": 0,
          "attributes": {
            "auto_ingest": false,
            "aws_sns_topic_arn": null,
            "comment": "",
            "copy_statement": "COPY INTO COST_COPILOT_DB.RAW.PIPE_EVENTS\n  (EVENT_ID, EVENT_TS, CUSTOMER_ID, PRODUCT_ID, QTY, UNIT_PRICE, EVENT_TYPE, RAW_RECORD)\nFROM (\n  SELECT\n    $1:event_id::NUMBER,\n    $1:event_ts::TIMESTAMP_NTZ,\n    $1:customer_id::NUMBER,\n    $1:product_id::NUMBER,\n    $1:qty::NUMBER,\n    $1:unit_price::NUMBER(12,2),\n    $1:event_type::VARCHAR,\n    $1\n  FROM @COST_COPILOT_DB.RAW.LAB_INT_STAGE/pipe_events/\n)\nFILE_FORMAT = (FORMAT_NAME = COST_COPILOT_DB.RAW.LAB_JSON_FF)",
            "database": "COST_COPILOT_DB",
            "error_integration": "",
            "id": "COST_COPILOT_DB|RAW|PIPE_EVENTS_JSON",
            "integration": null,
            "name": "PIPE_EVENTS_JSON",
            "notification_channel": "",
            "owner": "ACCOUNTADMIN",
            "schema": "RAW"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
